# ============================================================================
# Sensitive information — must never be committed
# ============================================================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials/
**/credentials*.json

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/

