# ============================================================================
# Sensitive information — must never be committed
# ============================================================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials/
**/credentials*.json

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# ============================================================================
# LaTeX auxiliary files (regenerated by xelatex/bibtex)
# ============================================================================
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.pyg
*.nav
*.snm
*.vrb
*.run.xml
*.bcf
missfont.log

# Vendored TeX trees (should be installed, not committed)
texmf-dist/
hyperxmp.tar.xz
hyperxmp.sty

# ============================================================================
# OS / editor noise
# ============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ============================================================================
# Build artefacts not under version control
# ============================================================================
*.tar.gz
*.zip

# Backup files (one-off snapshots not for version control)
*.bak
*.backup
*.before-*
*.prehumanize.*

# ============================================================================
# Style audit / process notes (kept locally, not in git)
# ============================================================================
style_audit/

# Claude-mem CLI session context (tool metadata, not project content)
AGENTS.md

# ============================================================================
# Reference reading (PDFs that are not redistributable)
# ============================================================================
已有论文/

# ============================================================================
# Allow-list — explicitly DO ship these (overrides above patterns)
# ============================================================================
!NOETHER_paper.pdf
!arxiv/NOETHER_paper_arxiv.pdf
!supplementary/**/*.csv
!supplementary/**/*.json
