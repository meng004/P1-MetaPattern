*.vrb
*.run.xml
*.bcf
missfont.log

# Vendored TeX trees (should be installed, not committed)
texmf-dist/
hyperxmp.tar.xz
hyperxmp.sty

# ============================================================================
# OS / editor noise
# ============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ============================================================================
# Build artefacts not under version control
# ============================================================================
*.tar.gz
*.zip
# Exception: the rater hand-out packet is version-controlled (per request)
!experiment_realbug/human_kappa/noether_rater_packet.zip

# Gradle / Java build outputs
build/
.gradle/
*.class

# Backup files (one-off snapshots not for version control)
*.bak
*.backup
*.before-*
*.prehumanize.*

# ============================================================================
# Style audit / process notes (kept locally, not in git)
# ============================================================================
style_audit/

# Claude-mem CLI session context (tool metadata, not project content)
AGENTS.md

# ============================================================================
# Reference reading (PDFs that are not redistributable)
# ============================================================================
已有论文/

# ============================================================================
# Allow-list — explicitly DO ship these (overrides above patterns)
# ============================================================================
!NOETHER_paper.pdf
!arxiv/NOETHER_paper_arxiv.pdf
!supplementary/**/*.csv
!supplementary/**/*.json

# === IMRaD restructure intermediates (kept locally for safety, not in git) ===
NOETHER_paper_imrad.tex
NOETHER_paper_imrad.pdf
NOETHER_paper_pre_imrad.tex
comment.cut
hyperxmp.tar.xz
missfont.log
arxiv/comment.cut
arxiv/*.aux
arxiv/*.bbl
arxiv/*.blg
arxiv/*.log
arxiv/*.out

# ============================================================================
# Local-only outputs (kept on disk, not version-controlled)
#   .claude/              : Claude Code session settings (contains local abs paths)
#   submission/           : packaged journal submission snapshots (derived; .zip already ignored)
#   experiment/           : s5 experiment working data (archived at Zenodo DOI 10.5281/zenodo.20250634)
#   arxiv/pdflatex_test/  : scratch LaTeX build directory
# ============================================================================
/.claude/
/submission/
/experiment/
/arxiv/pdflatex_test/
