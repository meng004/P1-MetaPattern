  author = {Fang-Hsiang Su and Jonathan Bell and Christian Murphy and Gail E Kaiser},
  title = {Dynamic Inference of Likely Metamorphic Properties to Support Differential Testing},
  journal = {2015 IEEE/ACM 10th International Workshop on Automation of Software Test},
