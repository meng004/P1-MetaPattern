# NOETHER environment-variable template.
# Copy this to .env (which is gitignored) and fill in real values.
#
# NOETHER is primarily a paper + reference implementation; environment
# variables are needed only for follow-up work (e.g. LLM-assisted Set L
# ensemble in supplementary/S4_reproducibility, or cross-tool Major
# replication in supplementary/S8_metricplus_sun2021_subjects).
#
# Never commit a real .env file. Use placeholders here for documentation.

# === LLM vendor keys (only for Set L ensemble re-execution) ===
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === P2 cross-project integration (only if running cross-paper analysis) ===
P2_ROOT=/path/to/MT完备性/src
P2_OUTPUTS_ROOT=/path/to/MT完备性/data/results

# === Major + JDK 11 path (supplementary/S8 cross-tool replication) ===
MAJOR_HOME=/path/to/major-jdk11
JAVA_11_HOME=/path/to/jdk-11.0.30

# === Verbose logging for replication scripts ===
NOETHER_DEBUG=0
