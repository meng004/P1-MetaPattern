# ============================================================================
# S5 Aligned Experiment — environment variables template
# ============================================================================
# Copy to `.env` (gitignored) and fill in real values for the local/cloud host.
#
# Single-variable design: only the MR set (Set N vs Set G) varies; all other
# substrate is fixed to GenMorph upstream's exact toolchain.
#
# ----------------------------------------------------------------------------
# Secret-handling boundary (CLAUDE.md rule 7)
# ----------------------------------------------------------------------------
# This file holds ONLY filesystem paths. It MUST NOT contain:
#   - real API keys (OpenAI / Anthropic / DeepSeek / Zhipu / Moonshot / Gemini /
#     etc.)
#   - Bearer tokens, OAuth client secrets, refresh tokens
#   - private SSH keys or proxy credentials
#   - personal absolute paths beyond /usr/lib/jvm/* and /tmp/* (use
#     <REPO_ROOT> or environment expansion for repo-relative paths)
#
# This means the file is safe to view in claude.ai web tier or Claude Code
# Remote. If a future task needs cloud-side credentials, generate them in the
# cloud platform's secret manager (e.g. GitHub Actions secrets, Cloudflare env
# vars), never here.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Java toolchains (system-installed by setup.sh)
# ----------------------------------------------------------------------------
# JDK 8 — required by GenMorph's GAssert evaluator and PIT 1.7.4 wrapper
JAVA8=/usr/lib/jvm/java-8-openjdk-amd64
# JDK 11 — convenience for local IDE work; experiment itself does not need it
JAVA11=/usr/lib/jvm/java-11-openjdk-amd64
# Default JAVA_HOME for the experiment runtime (must point to JDK 8)
JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64

# ----------------------------------------------------------------------------
# GenMorph upstream replication package (unpacked by setup.sh)
# ----------------------------------------------------------------------------
GENMORPH=/tmp/genmorph_pilot/genmorph_full/genmorph
GENMORPH_EVAL=/tmp/genmorph_pilot/evaluation/evaluation
GENMORPH_MRS=/tmp/genmorph_pilot/mrs/mrs

# Pre-built jars from GenMorph upstream (provided in the Zenodo archive)
GASSERT_JAR=/tmp/genmorph_pilot/genmorph_full/genmorph/build/libs/GAssert-1.0-SNAPSHOT-all.jar
PITEST_WRAPPER=/tmp/genmorph_pilot/genmorph_full/genmorph/pitest-wrapper-1.7.4.jar
RANDOOP_JAR=/tmp/genmorph_pilot/genmorph_full/genmorph/randoop-all-4.3.0.jar
EVOSUITE_JAR=/tmp/genmorph_pilot/genmorph_full/genmorph/evosuite-1.1.0.jar

# ----------------------------------------------------------------------------
# Experiment configuration
# ----------------------------------------------------------------------------
# Repo root (set automatically by setup.sh; override here for non-standard paths)
S5_ROOT=/home/user/S5_aligned_experiment

# Seed used by GenMorph upstream's published evaluation
SEED=11

# Subset of subjects to run; "all" = all 23, or comma-separated list
SUBJECTS=all
